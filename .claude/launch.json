{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "front-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "front-preview-proxy",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--config", ".claude/vite.preview.config.js"],
      "env": { "VITE_API_URL": "/api" },
      "port": 5180
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../../Old-Traveler-API/old-traveler-api", "start"],
      "port": 3000
    }
  ]
}
